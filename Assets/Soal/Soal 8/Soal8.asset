  m_EditorClassIdentifier: Assembly-CSharp::QuizData
  questionID: Soal_8
  questionText: "Berikut ini merupakan bentuk perencanaan yang dapat dilakukan untuk
    mendukung\r\npenerapan keselamatan dan kesehatan kerja (K3) di tempat kerja,
    kecuali \u2026"
  questionAudio: {fileID: 0}
  answers:
  - Pengurangan beban kerja dan kegiatan pengangkutan material
  - Penyediaan ruang gerak yang aman serta permukaan lantai yang tidak licin
  - Ketersediaan fasilitas evakuasi dalam keadaan darurat
  - Peningkatan gaji dan pemberian tunjangan kepada karyawan
  correctAnswerIndex: 3
